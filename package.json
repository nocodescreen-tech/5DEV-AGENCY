{
  "name": "5dev",
  "private": true,
  "version": "0.1.0",
  "description": "5DEV — plateforme digitale officielle (build. innovate. grow.)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@5dev/api & npm run dev --workspace=@5dev/web",
    "dev:api": "npm run dev --workspace=@5dev/api",
    "dev:web": "npm run dev --workspace=@5dev/web",
    "build": "npm run build --workspace=@5dev/shared && npm run build --workspace=@5dev/api && npm run build --workspace=@5dev/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "eslint": "9.15.0",
    "globals": "15.12.0",
    "prettier": "3.4.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.16.0"
  }
}
