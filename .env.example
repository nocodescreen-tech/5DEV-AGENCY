# ---------------------------------------------------------------------------
# 5DEV — variables d'environnement (copier en .env, ne JAMAIS commiter .env)
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_NAME=5DEV
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000

# Contacts publics (affichés sur le site, non secrets)
CONTACT_EMAIL=mio.appservice@gmail.com
CONTACT_PHONE=+243891755172
WHATSAPP_NUMBER=+243891755172

# Devises : devise de référence + devises supportées (séparées par virgule)
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,CDF

# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/5dev
DATABASE_SSL=false

# Sessions / sécurité
SESSION_SECRET=
JWT_SECRET=
SESSION_DAYS=7
ARGON2_MEMORY_COST=19456

# Stockage médias (S3-compatible ; R2 en cible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PREFIX=5dev/media/
MEDIA_SIGNED_TTL_SECONDS=3600
MEDIA_THUMB_WIDTHS=400,900,1600

# Alternative Cloudinary (non requise si S3 configuré)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email transactionnel (API HTTP recommandée en production)
MAIL_FROM="5DEV <mio.appservice@gmail.com>"
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Divers
RATE_LIMIT_AUTH_PER_15MIN=10
LOG_LEVEL=info
