    "sequelize": "6.37.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "5.0.0",
    "@types/node": "22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
